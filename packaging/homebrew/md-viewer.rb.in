# Generated by .github/workflows/build.yml on each v* tag; edit the template
# in vukasin-nikodijevic/markdown-viewer, not the copy in the tap.
class MdViewer < Formula
  desc "Render Markdown files in a native window with GitHub styling"
  homepage "https://github.com/vukasin-nikodijevic/markdown-viewer"
  license "MIT"

  # Prebuilt binaries from the GitHub release: building from source on Linux
  # would pull in Homebrew's whole webkitgtk stack instead of the system one.
  on_macos do
    on_arm do
      url "https://github.com/vukasin-nikodijevic/markdown-viewer/releases/download/v@VERSION@/md-viewer_@VERSION@_darwin_arm64.tar.gz"
      sha256 "@SHA256_DARWIN_ARM64@"
    end
    on_intel do
      url "https://github.com/vukasin-nikodijevic/markdown-viewer/releases/download/v@VERSION@/md-viewer_@VERSION@_darwin_amd64.tar.gz"
      sha256 "@SHA256_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/vukasin-nikodijevic/markdown-viewer/releases/download/v@VERSION@/md-viewer_@VERSION@_linux_arm64.tar.gz"
      sha256 "@SHA256_LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/vukasin-nikodijevic/markdown-viewer/releases/download/v@VERSION@/md-viewer_@VERSION@_linux_amd64.tar.gz"
      sha256 "@SHA256_LINUX_AMD64@"
    end
  end

  def install
    bin.install "md-viewer"
  end

  def caveats
    on_linux do
      <<~EOS
        md-viewer uses the system's GTK 3 and WebKitGTK 4.1. On Debian/Ubuntu:
          sudo apt install libgtk-3-0 libwebkit2gtk-4.1-0
      EOS
    end
  end

  test do
    # Must not open a GUI window; the usage error is enough
    assert_match "Usage", shell_output("#{bin}/md-viewer 2>&1", 1)
  end
end
